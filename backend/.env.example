# ==========================================
# OmniAI Backend (FastAPI) Production Configuration
# Render Deployment Environment Variables
# ==========================================

# 1. Server & Networking
HOST=0.0.0.0
PORT=8001
# Comma-separated list of allowed origins (e.g. your Vercel URL)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# Regex to match any Vercel deployment preview/production URL
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# 2. Database Configuration
# For Render PostgreSQL: postgresql+psycopg://username:password@host:5432/dbname
# For local / development: sqlite:///./test.db
DATABASE_URL=sqlite:///./test.db

# 3. JWT Authentication Security
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 4. Primary AI Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here

# 5. Fallback & Search Provider Keys (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
SERPAPI_API_KEY=your_serpapi_key_here
TAVILY_API_KEY=your_tavily_key_here
HUGGINGFACE_API_KEY=your_huggingface_key_here

# 6. Email OTP Authentication (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# 7. Firebase Auth / Google OAuth (Optional)
# If using Firebase Admin SDK, place your json file in backend/ or set path:
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 8. Supabase (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
