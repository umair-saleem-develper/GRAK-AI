# ==========================================
# OmniAI Deployment .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.env
firebase-service-account*.json
*.pem
*.key
*.cert

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.venv/
.venv*/
venv/
env/
ENV/

# Node.js & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/test.db

# Generated downloads / media (keep directory)
backend/downloads/*
!backend/downloads/.gitkeep

# Temporary test logs & screenshots
backend_logs.txt
extracted_page.txt
test_output.txt
fetch_output.txt
evidence_*.png
screenshot_*.png
convo_plant.png

# OS & IDE
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
