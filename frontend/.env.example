# ==========================================
# OmniAI Frontend (Next.js) Production Configuration
# Vercel Deployment Environment Variables
# ==========================================

# 1. Backend URL (Pointing to your deployed Render FastAPI service)
# Example: https://omniai-backend.onrender.com
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# 2. Voice WebSocket URL (Optional - if omitted, auto-derived from NEXT_PUBLIC_API_URL)
# Example: wss://omniai-backend.onrender.com/api/voice/grak-speak
NEXT_PUBLIC_WS_URL=wss://your-backend.onrender.com/api/voice/grak-speak

# 3. Environment Tag
NEXT_PUBLIC_APP_ENV=production

# 4. Firebase Auth Credentials (Optional - if using Google Sign-In)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
